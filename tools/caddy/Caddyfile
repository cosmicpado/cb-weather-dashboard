# 충북소방 기상재난 통합플랫폼 — Caddy HTTPS 리버스 프록시
# Caddy(443) 가 HTTPS 를 받아서 같은 PC 의 서버.bat(8000) 으로 넘긴다.
# 아래 셋 중 하나만 # 없이 남겨 둔다. (Caddy 2.10 이상)

# ── ① IP 주소 그대로 정식 인증서 (Let's Encrypt 'shortlived', 6일짜리 → Caddy 가 자동 갱신) ─
#    고정 공인 IP 이고, 인터넷에서 80·443 이 이 PC 로 들어와야 한다.
https://222.116.90.199 {
	tls {
		issuer acme {
			profile shortlived
		}
	}
	reverse_proxy 127.0.0.1:8000
}

# ── ② 도메인 → Let's Encrypt 일반 인증서 (예: xxx.duckdns.org) ───────────────
# xxx.duckdns.org {
# 	reverse_proxy 127.0.0.1:8000
# }

# ── ③ 시험: Caddy 자체 인증서 (브라우저 "안전하지 않음" 경고) ──────────────────
# https://222.116.90.199 {
# 	tls internal
# 	reverse_proxy 127.0.0.1:8000
# }
