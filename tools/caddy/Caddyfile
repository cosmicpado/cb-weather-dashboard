# 충북소방 기상정보 통합플랫폼 — Caddy HTTPS 리버스 프록시
# Caddy(443) 가 HTTPS 를 받아서 같은 PC 의 서버.bat(8000) 으로 넘긴다.
# 아래 셋 중 하나만 # 없이 남겨 둔다. (Caddy 2.10 이상)

# 관리용 포트(2019)는 쓰지 않는다 — Windows 가 이 포트를 막아 두면 Caddy 가 켜지지 않는다
# HTTP/3(UDP 443)은 끈다 — 방화벽에 TCP 443 만 열려 있으면 첫 접속이 멈추고 새로고침해야 뜬다
#  로그 시간은 기본이 UTC(한국보다 9시간 늦음) → 이 PC 시간(한국 시간)으로, 읽기 쉬운 줄 형식
{
	admin off
	log {
		format console {
			time_local
			time_format "2006-01-02 15:04:05"
		}
	}
	servers {
		protocols h1 h2
	}
}

# 서버(8000)는 응답마다 연결을 닫는다 → Caddy 가 닫힌 연결을 다시 쓰다 502 가 나지 않게 매번 새로 연결
# 글자 파일(자료·지도·화면)은 압축해 보낸다 — 휴대폰처럼 느린 회선에서 빨라진다(그림 파일은 원래 압축돼 있어 그대로)
# 보안 머리글 — HSTS(한 번 https 로 온 브라우저는 다음부터 http 를 쓰지 않는다. ⚠ IP 주소 접속에는 브라우저가 적용하지 않고
#   도메인을 쓰면 효력이 생긴다) · Server 머리글 지우기(서버 종류를 알리지 않는다)
# 접근 로그 — logs\access.log (20MB 넘으면 새 파일, 10개·30일까지). '/.env'·'/wp-admin' 같은 수상한 요청을 나중에 찾아볼 수 있게
#   요청 머리글도 함께 적히므로 관리자 키(X-Admin-Key)는 지우고 적는다(쿠키는 Caddy 가 원래 가린다)
(to_server) {
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	log {
		output file logs/access.log {
			roll_size 20MiB
			roll_keep 10
			roll_keep_for 720h
		}
		format filter {
			wrap console {
				time_local
				time_format "2006-01-02 15:04:05"
			}
			fields {
				request>headers>X-Admin-Key delete
			}
		}
	}
	encode zstd gzip
	reverse_proxy 127.0.0.1:8000 {
		transport http {
			keepalive off
		}
	}
}

# ── ① IP 주소 그대로 정식 인증서 (Let's Encrypt 'shortlived', 6일짜리 → Caddy 가 자동 갱신) ─
#    고정 공인 IP 이고, 인터넷에서 80·443 이 이 PC 로 들어와야 한다.
https://222.116.90.199 {
	tls {
		issuer acme {
			profile shortlived
		}
	}
	import to_server
}

# ── ② 도메인 → Let's Encrypt 일반 인증서 (예: xxx.duckdns.org) ───────────────
# xxx.duckdns.org {
# 	import to_server
# }

# ── ③ 시험: Caddy 자체 인증서 (브라우저 "안전하지 않음" 경고) ──────────────────
# https://222.116.90.199 {
# 	tls internal
# 	import to_server
# }
