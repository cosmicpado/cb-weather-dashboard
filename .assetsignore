# wrangler가 Cloudflare Workers 정적 자산으로 업로드할 때 제외할 패턴
# (.gitignore와 동일 문법)
#
# 사이트에 배포될 파일: index.html, data.js, icon.svg, manifest.json,
# service-worker.js, images/, 화면(*.html)·스크립트(*.js)

# === 🔒 보안 critical — API 키·인증 정보 ===
.env
.env.*
credentials.json
token.json
*.pem
*.key

# === Git 메타데이터 (가장 큰 폴더 — 200MiB+) ===
.git/
.gitignore
.gitattributes

# === GitHub Actions / 워크플로우 ===
.github/

# === 직원 의견 원본(개인 정보) ===
feedback/

# === 빌드 도구 / 운영 폴더 ===
.tmp/
.claude/
.vscode/
.idea/
node_modules/

# === Python 소스 (소스코드 노출 차단) ===
tools/
__pycache__/
*.py
*.pyc
*.pyo
requirements.txt

# === 운영 문서 / 가이드 (사이트와 무관) ===
workflows/
*.md
CLAUDE.md
README*

# === 윈도우 스크립트 (PC 전용) ===
*.bat
*.vbs
*.ps1

# === wrangler 설정 (배포 도구 자체) ===
wrangler.toml
wrangler.json
.assetsignore
_worker.js
